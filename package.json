{
  "name": "baller",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "server": "node --env-file-if-exists=.env.local server/index.mjs",
    "db:status": "node --env-file-if-exists=.env.local scripts/database.mjs status",
    "db:import-cache": "node --env-file-if-exists=.env.local scripts/database.mjs import-cache",
    "db:import-json": "node --env-file-if-exists=.env.local scripts/database.mjs import-json",
    "db:prune-cache": "node --env-file-if-exists=.env.local scripts/database.mjs prune-cache"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
