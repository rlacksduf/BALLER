# https://highlightly.net 에서 발급한 Football API 키 (VITE_ 접두사 사용 금지)
HIGHLIGHTLY_API_KEY=

# 로컬 PostgreSQL이 기본값입니다. 외부 API 수집은 기본 비활성화.
BALLER_DB_DRIVER=local
BALLER_ALLOW_LIVE_API=false
# Supabase 연결 시에만 설정 (브라우저 공개 변수 사용 금지)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 별도 서버 주소: 127.0.0.1:3001 (기본값)
BALLER_PORT=3001

# 별도 서버와 프론트를 함께 실행할 때
BALLER_BACKEND_URL=http://127.0.0.1:3001
# 로컬 화면에서 브라우저 라이브러리 DB 가져오기 허용
BALLER_ALLOW_BROWSER_IMPORT=true
